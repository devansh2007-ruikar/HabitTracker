<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:paddingBottom="96dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Habit Selector Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_select_habit"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Habit"
            app:boxStrokeWidth="2dp"
            app:boxStrokeColor="?attr/colorOutline"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp">

            <AutoCompleteTextView
                android:id="@+id/actv_select_habit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:textStyle="bold"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Container for Stats Content -->
        <LinearLayout
            android:id="@+id/layout_stats_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  Colored Tiles Row (Current Streak, Longest, Completion %)  -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- 1. Current Streak Colored Tile (GDG Red Tint) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile_streak_current">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/stat_current_streak"
                            app:srcCompat="@drawable/ic_fire"
                            app:tint="@color/streak_fire" />

                        <TextView
                            android:id="@+id/tv_stat_current_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="5 d" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_current_streak"
                            android:fontFamily="@font/space_grotesk"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </FrameLayout>

                <!-- 2. Longest Streak Colored Tile (GDG Yellow Tint) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile_streak_best">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/stat_best_streak"
                            app:srcCompat="@drawable/ic_trophy"
                            app:tint="@color/gdg_yellow" />

                        <TextView
                            android:id="@+id/tv_stat_best_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="14 d" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_best_streak"
                            android:fontFamily="@font/space_grotesk"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </FrameLayout>

                <!-- 3. Completion % Colored Tile (GDG Green Tint) -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile_completion">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/stat_completion_rate"
                            app:srcCompat="@drawable/ic_check"
                            app:tint="@color/status_complete" />

                        <TextView
                            android:id="@+id/tv_completion_rate_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="85%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat_completion_rate"
                            android:fontFamily="@font/space_grotesk"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  Completion Rate Range Card                                -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_brutalist_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completion Analysis"
                            android:fontFamily="@font/space_grotesk"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: "
                                android:fontFamily="@font/inter"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tv_stat_total_completions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                tools:text="28" />

                        </LinearLayout>

                    </RelativeLayout>

                    <!-- Range Toggle Group -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_range_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:checkedButton="@id/btn_range_30_days"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_range_7_days"
                            style="@style/Widget.HabitTracker.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:text="@string/range_7_days" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_range_30_days"
                            style="@style/Widget.HabitTracker.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:text="@string/range_30_days" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_range_all_time"
                            style="@style/Widget.HabitTracker.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:text="@string/range_all" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_completion_rate"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="14dp"
                        app:trackCornerRadius="4dp"
                        app:trackColor="?attr/colorSurfaceVariant"
                        app:indicatorColor="?attr/colorPrimary"
                        tools:progress="85" />

                </LinearLayout>

            </FrameLayout>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  Weekly Bar Chart Card                                     -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_brutalist_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weekly_chart_title"
                        android:fontFamily="@font/space_grotesk"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/bar_chart_weekly"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp" />

                </LinearLayout>

            </FrameLayout>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!--  Activity Calendar Heatmap Card                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_brutalist_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Month Navigation Header -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageButton
                            android:id="@+id/btn_prev_month"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Previous month"
                            app:srcCompat="@drawable/ic_chevron_left"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tv_calendar_month_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:fontFamily="@font/space_grotesk"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            tools:text="October 2026" />

                        <ImageButton
                            android:id="@+id/btn_next_month"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Next month"
                            app:srcCompat="@drawable/ic_chevron_right"
                            app:tint="?attr/colorOnSurface" />

                    </RelativeLayout>

                    <!-- Days of Week Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView style="@style/TextAppearance.Material3.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:text="M" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView style="@style/TextAppearance.Material3.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:text="T" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView style="@style/TextAppearance.Material3.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:text="W" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView style="@style/TextAppearance.Material3.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:text="T" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView style="@style/TextAppearance.Material3.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:text="F" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView style="@style/TextAppearance.Material3.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:text="S" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView style="@style/TextAppearance.Material3.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:text="S" android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!-- 7-Column Calendar Grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_calendar_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="7"
                        tools:itemCount="35"
                        tools:listitem="@layout/item_calendar_day" />

                    <!-- Status Color Legend -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dot_complete" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/legend_complete" android:fontFamily="@font/space_grotesk" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" />

                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="10dp" android:background="@drawable/bg_dot_complete" app:backgroundTint="@color/status_partial" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/legend_partial" android:fontFamily="@font/space_grotesk" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" />

                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="10dp" android:background="@drawable/bg_dot_complete" app:backgroundTint="@color/status_missed" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/legend_missed" android:fontFamily="@font/space_grotesk" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" />

                        <View android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="10dp" android:background="@drawable/bg_dot_complete" app:backgroundTint="@color/status_not_scheduled" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="@string/legend_not_scheduled" android:fontFamily="@font/space_grotesk" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Empty State (No habits in database) -->
        <LinearLayout
            android:id="@+id/layout_stats_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_brutalist_card">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/stats_title"
                    app:srcCompat="@drawable/ic_stats"
                    app:tint="?attr/colorPrimary" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No habits available"
                android:fontFamily="@font/space_grotesk"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:fontFamily="@font/inter"
                android:text="Create a habit first to see statistics, streaks, and charts."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
