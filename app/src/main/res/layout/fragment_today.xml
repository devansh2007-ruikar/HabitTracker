<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top Header: Greeting + Date Header + Progress Chip -->
    <LinearLayout
        android:id="@+id/layout_today_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/chip_today_progress"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="?attr/colorOnBackground"
                    android:textStyle="bold"
                    tools:text="Good morning! ☀️" />

                <TextView
                    android:id="@+id/tv_header_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Sunday, 11 October 2026" />

            </LinearLayout>

            <!-- "3 of 5 done today" Neo-Brutalist Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_today_progress"
                style="@style/Widget.HabitTracker.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="false"
                android:focusable="false"
                app:chipIcon="@drawable/ic_check"
                app:chipIconSize="16dp"
                app:chipIconTint="?attr/colorPrimary"
                tools:text="3 of 5 done today" />

        </RelativeLayout>

    </LinearLayout>

    <!-- 7-Day Date Selector Strip Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_date_strip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/layout_today_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_date_strip" />

    <!-- Mode Toggle: Habits vs Tasks -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_group_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btn_mode_habits"
        app:layout_constraintTop_toBottomOf="@id/rv_date_strip"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_habits"
            style="@style/Widget.HabitTracker.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/nav_habits"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_tasks"
            style="@style/Widget.HabitTracker.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/todo_title"
            android:textSize="12sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Current Selected Date Label -->
    <TextView
        android:id="@+id/tv_selected_date_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="end|center_vertical"
        android:fontFamily="@font/space_grotesk"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toTopOf="@id/toggle_group_mode"
        app:layout_constraintBottom_toBottomOf="@id/toggle_group_mode"
        app:layout_constraintStart_toEndOf="@id/toggle_group_mode"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Showing Sunday, Oct 11" />

    <!-- Habits List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_today_habits"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/toggle_group_mode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_today_habit" />

    <!-- Habits Empty State -->
    <LinearLayout
        android:id="@+id/layout_today_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toggle_group_mode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_brutalist_card">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@string/today_empty_title"
                app:srcCompat="@drawable/ic_today"
                app:tint="?attr/colorPrimary" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/today_empty_title"
            android:fontFamily="@font/space_grotesk"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:fontFamily="@font/inter"
            android:text="@string/today_empty_subtitle"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_add_habit"
            style="@style/Widget.HabitTracker.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:contentDescription="@string/add_habit"
            android:text="@string/add_habit"
            app:icon="@drawable/ic_add" />

    </LinearLayout>

    <!-- To-Do Tasks Section -->
    <LinearLayout
        android:id="@+id/layout_tasks_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toggle_group_mode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Quick Add Task Bar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_brutalist_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_new_task_title"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/todo_add_hint"
                    android:fontFamily="@font/inter"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_task"
                    style="@style/Widget.HabitTracker.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="Add"
                    app:icon="@drawable/ic_add" />

            </LinearLayout>

        </FrameLayout>

        <!-- Tasks List -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_todo_tasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_todo_task" />

            <LinearLayout
                android:id="@+id/layout_tasks_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_brutalist_card">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="All tasks done"
                        app:srcCompat="@drawable/ic_check"
                        app:tint="?attr/colorPrimary" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/todo_empty_title"
                    android:fontFamily="@font/space_grotesk"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
